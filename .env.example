DEBUG=False
SECRET_KEY=your-secret-key

# Comma-separated. Базовые ALLOWED_HOSTS (localhost, doctor-barkova.ru, ...)
# уже зашиты в settings.py; здесь добавляются дополнительные (IP сервера,
# новый домен и т.п.) без правки кода.
ALLOWED_HOSTS_EXTRA=
CSRF_TRUSTED_ORIGINS_EXTRA=

DB_NAME=doctor_db
DB_USER=doctor_user
DB_PASSWORD=your-db-password
DB_HOST=db
DB_PORT=5432

# Логирование: json для prod (структурированные логи для ELK/Loki),
# verbose для локальной разработки. Если не задан — json при DEBUG=False.
LOG_FORMAT=
LOG_LEVEL=INFO

# Sentry. Оставьте пустым чтобы выключить error reporting.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

INTERNAL_API_URL=http://backend:8000/api
NEXT_PUBLIC_API_URL=/api
BACKEND_BASE_URL=http://backend:8000

NEXT_PUBLIC_VK_APP_ID=your-vk-app-id
VK_GROUP_TOKEN=your-vk-group-token
VK_GROUP_ID=your-vk-group-id
VK_GROUP_DOMAIN=your-vk-domain
VK_APP_ID=your-vk-app-id
VK_APP_SECRET=your-vk-app-secret
VK_CALLBACK_CONFIRMATION_CODE=your-confirmation-code
VK_CALLBACK_SECRET=your-vk-callback-secret
VK_ID_REDIRECT_URL=https://your-domain.ru/auth/vk/callback

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id
TELEGRAM_BOT_USERNAME=your-bot-username

# HTTPS-прокси для исходящих к api.telegram.org.
# Нужен на российских хостингах, где Telegram заблокирован.
# Формат: http://USER:PASS@HOST:PORT  или  http://HOST:PORT
# Оставьте пустым если хостинг вне РФ.
TELEGRAM_PROXY_URL=

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1