DEBUG=False
SECRET_KEY=your-secret-key

# Comma-separated. Базовые ALLOWED_HOSTS (localhost, doctor-barkova.ru, ...)
# уже зашиты в settings.py; здесь добавляются дополнительные (IP сервера,
# новый домен и т.п.) без правки кода.
ALLOWED_HOSTS_EXTRA=
CSRF_TRUSTED_ORIGINS_EXTRA=

DB_NAME=doctor_db
DB_USER=doctor_user
DB_PASSWORD=your-db-password
DB_HOST=db
DB_PORT=5432

# Логирование: json для prod (структурированные логи для ELK/Loki),
# verbose для локальной разработки. Если не задан — json при DEBUG=False.
LOG_FORMAT=
LOG_LEVEL=INFO

# Sentry. Оставьте пустым чтобы выключить error reporting.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

INTERNAL_API_URL=http://backend:8000/api
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_VK_APP_ID=your-vk-app-id
VK_GROUP_TOKEN=your-vk-group-token
VK_GROUP_ID=your-vk-group-id
# Короткое имя сообщества из адреса vk.com/<имя>: для ссылки vk.me/<имя>
VK_GROUP_DOMAIN=your-vk-domain
VK_APP_ID=your-vk-app-id
VK_CALLBACK_CONFIRMATION_CODE=your-confirmation-code
VK_CALLBACK_SECRET=your-vk-callback-secret

# ── Оповещения врача ──────────────────────────────────────────────
# Числовые id личных страниц VK врача/администратора через запятую.
# Каждый должен один раз написать сообществу, иначе сообщество не сможет
# ему писать. Проверка: python manage.py send_test_doctor_alert
VK_DOCTOR_USER_IDS=
# Резервный email, если VK-алерт не дошёл (необязательно).
DOCTOR_ALERT_EMAILS=
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Час утренней сводки врачу (по времени расписания)
DOCTOR_DIGEST_HOUR=8

# ── Расписание ────────────────────────────────────────────────────
# Пояс, в котором врач вводит слоты. Если вводите по Москве — Europe/Moscow.
TIME_ZONE=Asia/Tomsk
SCHEDULE_CITY_GENITIVE=Томска

# ── Сервер ────────────────────────────────────────────────────────
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── SEO / verification ────────────────────────────────────────────
# Коды верификации, которые выдают Google Search Console и
# Яндекс.Вебмастер при добавлении сайта (вариант «HTML-тег»). Без них
# сайт нельзя подтвердить владельцем — оставьте пустыми, пока не
# зарегистрировались.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Гео-данные для structured data (Physician/MedicalBusiness schemas).
# Дефолты — Томск, Советская 86. Поменяйте если адрес другой.
NEXT_PUBLIC_GEO_LATITUDE=56.4694
NEXT_PUBLIC_GEO_LONGITUDE=84.9518
NEXT_PUBLIC_GEO_LOCALITY=Томск
NEXT_PUBLIC_GEO_REGION=Томская область
NEXT_PUBLIC_GEO_POSTAL_CODE=634034